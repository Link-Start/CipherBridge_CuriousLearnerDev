{
  "manifest_version": 3,
  "name": "CipherBridge Hook",
  "version": "1.1.0",
  "description": "密桥密钥 Hook：点击图标可开关页面注入",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "CipherBridge Hook",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "options.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}